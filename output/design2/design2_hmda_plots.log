. /*===========================================================================
> ===
>  design2_hmda_plots.do
> 
>  Event-study figures for the Poisson HMDA results (hmda_pois_coefs.csv).
>  Coefficients x100 ~ percent effects on origination counts.
> 
>    figH1_purchases   owner-occupied vs non-owner-occupied purchase counts
>    figH2_refis       rate/term vs cash-out refinancing counts
>    figH3_total       all originations
> =============================================================================
> =*/
. 
. version 17

. clear all

. set more off

. 
. global REPO "C:/Users/mva884/Documents/GitHub/ClaudeAct2260MergeExercise"

. global REPO "C:/Users/mva284/Documents/GitHub/ClaudeAct2260MergeExercise"

. global OUT  "$REPO/output/design2"

. 
. import delimited "$OUT/hmda_pois_coefs.csv", varnames(1) clear
(encoding automatically selected: ISO-8859-1)
(6 vars, 40 obs)

. drop if h == 99
(5 observations deleted)

. replace b  = 100 * b
(30 real changes made)

. replace lb = 100 * lb
(30 real changes made)

. replace ub = 100 * ub
(30 real changes made)

. rename h horizon

. rename outcome test

. tempfile coefs

. save `coefs'
file C:\Users\mva284\AppData\Local\Temp\ST_3180_000001.tmp saved as .dta
    format

. 
. capture program drop drawfig

. program define drawfig
  1.     syntax, out(string)
  2.     local STYLE  graphregion(color(white)) bgcolor(white) ///
>                  ylabel(, angle(horizontal) format(%9.0f)) ///
>                  yline(0, lcolor(gs8) lwidth(thin)) ///
>                  xline(-0.5, lcolor(gs11) lpattern(dash))
  3.     local colors navy cranberry
  4.     local n : word count $FIG_TESTS
  5.     local plots
  6.     local legorder
  7.     local i = 0
  8.     foreach t of global FIG_TESTS {
  9.         local ++i
 10.         local col : word `i' of `colors'
 11.         local off = cond(`n'==1, 0, (`i' - (`n'+1)/2) * 0.10)
 12.         capture drop x`i'
 13.         gen x`i' = horizon + `off' if test == "`t'"
 14.         local lab : word `i' of $FIG_LABELS
 15.         local plots `plots' ///
>             (rcap ub lb x`i' if test == "`t'", lcolor(`col') lwidth(medthin))
>  ///
>             (connected b x`i' if test == "`t'", color(`col') msymbol(O) lwidt
> h(medthin))
 16.         local legorder `legorder' `= 2*`i'' "`lab'"
 17.     }
 18.     if `n' == 1 local legend legend(off)
 19.     else        local legend legend(order(`legorder') rows(1) position(6) 
> region(lstyle(none)))
 20.     twoway `plots', `STYLE' `legend' ///
>         title("$FIG_TITLE", size(medium)) ///
>         ytitle("$FIG_YT") xtitle("$FIG_XT") ///
>         note("$FIG_NOTE", size(vsmall)) ///
>         xlabel(-3(1)3) name(`out', replace)
 21.     graph export "$OUT/`out'.png", replace width(2000)
 22. end

. 
. local XT "Years since first investor purchase in tract"

. local YT "Effect on origination counts (100 x Poisson coef ~ %)"

. local CAV "ppmlhdfe with tract and year FE, never-treated controls, SEs clust
> ered by tract; endpoints binned; TWFE caveat under staggered adoption. HMDA c
> overs financed purchases only -- decree investors are largely cash buyers."

. 
