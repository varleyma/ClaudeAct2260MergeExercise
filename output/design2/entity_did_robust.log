. tempname pf

. postfile `pf' str16 spec double win h b se using "$OUT/_er.dta", replace
(file
    C:/Users/mva284/Documents/GitHub/ClaudeAct2260MergeExercise/output/design
    > 2/_er.dta not found)

. 
. capture program drop runes

. program define runes
  1.     * runes <yvar> <spec> <cond> <win: 2|3> <pf>
.     args yvar spec cond win pf
  2.     preserve
  3.     if "`cond'" != "" keep if `cond'
  4.     di as result _n "===== `spec' (window +`win') ====="
  5.     if `win' == 3 {
  6.         reghdfe `yvar' Dm4 Dm3 Dm2 D0 D1 D2 D3, absorb(tract_num year) vce
> (cluster tract_num)
  7.         local hs -4 -3 -2 0 1 2 3
  8.         local ds Dm4 Dm3 Dm2 D0 D1 D2 D3
  9.     }
 10.     else {
 11.         reghdfe `yvar' Dm4 Dm3 Dm2 D0 D1 D2p, absorb(tract_num year) vce(c
> luster tract_num)
 12.         local hs -4 -3 -2 0 1 2
 13.         local ds Dm4 Dm3 Dm2 D0 D1 D2p
 14.     }
 15.     local i = 0
 16.     foreach h of local hs {
 17.         local ++i
 18.         local d : word `i' of `ds'
 19.         post `pf' ("`spec'") (`win') (`h') (_b[`d']) (_se[`d'])
 20.     }
 21.     post `pf' ("`spec'") (`win') (-1) (0) (.)
 22.     restore
 23. end

. 
. foreach w in 3 2 {
  2.     use `panel', clear
  3.     runes port10_n baseline "" `w' `pf'
  4.     use `panel', clear
  5.     runes port10_n dropblip "blip == 0" `w' `pf'
  6.     use `panel', clear
  7.     runes anyport extensive "" `w' `pf'
  8.     use `panel', clear
  9.     runes port_cap capped "" `w' `pf'
 10.     * cohort cut: post-2014 adopters only -- avoids the Cobian Plaza 2014
.     * acquisition without outcome-based tract selection
.     use `panel', clear
 11.     runes port10_n post2014 "missing(first_event_year) | first_event_year 
> >= 2015" `w' `pf'
 12. }

