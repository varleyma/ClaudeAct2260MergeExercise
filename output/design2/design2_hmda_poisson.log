. foreach v in purch_oo_n purch_nonoo_n refi_n cashout_n total_n {
  2.     di as result _n "===== POISSON event study: `v' ====="
  3.     ppmlhdfe `v' Dm3 Dm2 D0 D1 D2 D3, absorb(tract_num year) vce(cluster t
> ract_num)
  4.     post `pf' ("`v'") (-3) (_b[Dm3]) (_se[Dm3])
  5.     post `pf' ("`v'") (-2) (_b[Dm2]) (_se[Dm2])
  6.     post `pf' ("`v'") (-1) (0) (.)
  7.     post `pf' ("`v'") (0)  (_b[D0]) (_se[D0])
  8.     post `pf' ("`v'") (1)  (_b[D1]) (_se[D1])
  9.     post `pf' ("`v'") (2)  (_b[D2]) (_se[D2])
 10.     post `pf' ("`v'") (3)  (_b[D3]) (_se[D3])
 11. 
.     di as result _n "===== POISSON pooled post: `v' ====="
 12.     ppmlhdfe `v' treat, absorb(tract_num year) vce(cluster tract_num)
 13.     post `pf' ("`v'") (99) (_b[treat]) (_se[treat])
 14. }

