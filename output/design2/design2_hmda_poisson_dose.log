. foreach v in purch_oo_n purch_nonoo_n refi_n cashout_n total_n {
  2.     di as result _n "===== POISSON 5+ dose: `v' ====="
  3.     capture noisily ppmlhdfe `v' Dm3 Dm2 D0 D1 D2 D3, absorb(tract_num yea
> r) vce(cluster tract_num)
  4.     if !_rc {
  5.         foreach spec in "Dm3 -3" "Dm2 -2" "D0 0" "D1 1" "D2 2" "D3 3" {
  6.             local nm : word 1 of `spec'
  7.             local hh : word 2 of `spec'
  8.             post `pf' ("`v'") (`hh') (_b[`nm']) (_se[`nm'])
  9.         }
 10.     }
 11.     capture noisily ppmlhdfe `v' treat, absorb(tract_num year) vce(cluster
>  tract_num)
 12.     if !_rc post `pf' ("`v'") (99) (_b[treat]) (_se[treat])
 13. }

