. foreach v in lninc_all lninc_hisp {
  2.     di as result _n "===== `v': BASELINE (tract + year FE) pooled ====="
  3.     reghdfe `v' treat, absorb(tract_num year) vce(cluster tract_num)
  4. 
.     di as result _n "===== `v': + tract-specific linear trends, pooled ====="
  5.     reghdfe `v' treat, absorb(tract_num year tract_num#c.year) vce(cluster
>  tract_num)
  6.     post `pf' ("`v'") (99) (_b[treat]) (_se[treat])
  7. 
.     di as result _n "===== `v': + tract-specific linear trends, event study =
> ===="
  8.     reghdfe `v' Dm3 Dm2 D0 D1 D2 D3, absorb(tract_num year tract_num#c.yea
> r) ///
>         vce(cluster tract_num)
  9.     post `pf' ("`v'") (-3) (_b[Dm3]) (_se[Dm3])
 10.     post `pf' ("`v'") (-2) (_b[Dm2]) (_se[Dm2])
 11.     post `pf' ("`v'") (-1) (0) (.)
 12.     post `pf' ("`v'") (0)  (_b[D0]) (_se[D0])
 13.     post `pf' ("`v'") (1)  (_b[D1]) (_se[D1])
 14.     post `pf' ("`v'") (2)  (_b[D2]) (_se[D2])
 15.     post `pf' ("`v'") (3)  (_b[D3]) (_se[D3])
 16. }

