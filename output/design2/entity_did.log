. foreach v in entity_n port10_n port25_n {
  2.     use `panel', clear
  3.     di as result _n "===== POISSON `v' (tract DiD, 2012-2025) ====="
  4.     ppmlhdfe `v' `DVARS', absorb(tract_num year) vce(cluster tract_num)
  5.     post `pf' ("`v'") (-4) (_b[Dm4]) (_se[Dm4])
  6.     post `pf' ("`v'") (-3) (_b[Dm3]) (_se[Dm3])
  7.     post `pf' ("`v'") (-2) (_b[Dm2]) (_se[Dm2])
