 12.     post `pf' ("`v'") (3)  (_b[D3]) (_se[D3])
 13. 
.     di as result _n "===== POISSON pooled `v' ====="
 14.     ppmlhdfe `v' treat, absorb(tract_num year) vce(cluster tract_num)
 15.     post `pf' ("`v'") (99) (_b[treat]) (_se[treat])
 16. }

