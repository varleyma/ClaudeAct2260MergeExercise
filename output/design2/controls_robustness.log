. capture program drop ladder

. program define ladder
  1.     * ladder <yvar> <estimator: ols|ppml> <pf>
.     args yvar est pf
  2.     forvalues s = 1/3 {
  3.         if `s' == 1 local abs absorb(tract_num year)
  4.         if `s' == 2 local abs absorb(tract_num cyear)
  5.         if `s' == 3 local abs absorb(tract_num cyear)
  6.         local rhs treat
  7.         if `s' == 3 local rhs treat $ZP
  8.         di as result _n "===== `yvar' spec `s' ====="
  9.         if "`est'" == "ols" {
 10.             reghdfe `yvar' `rhs', `abs' vce(cluster tract_num)
 11.             local r2 = e(r2)
 12.         }
 13.         else {
 14.             ppmlhdfe `yvar' `rhs', `abs' vce(cluster tract_num)
 15.             local r2 = e(r2_p)
 16.         }
 17.         post `pf' ("`yvar'") (`s') (_b[treat]) (_se[treat]) (`r2') (e(N))
 18.     }
 19. end

