. *---- C. income dose --------------------------------------------------------
> --
. foreach g in hi5 lo14 {
  2.     use `panel', clear
  3.     if "`g'" == "hi5"  keep if nevertr | n_events >= 5
  4.     if "`g'" == "lo14" keep if nevertr | inrange(n_events, 1, 4)
  5.     di as result _n "===== OLS lninc_all dose `g' (2012-2024) ====="
  6.     reghdfe lninc_all `DVARS', absorb(tract_num year) vce(cluster tract_nu
> m)
  7.     grabes `pf' inc_`g'
  8.     di as result _n "===== OLS pooled lninc_all dose `g' ====="
  9.     reghdfe lninc_all treat, absorb(tract_num year) vce(cluster tract_num)
 10.     post `pf' ("inc_`g'") (99) (_b[treat]) (_se[treat])
 11. }
