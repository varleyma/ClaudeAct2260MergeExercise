. foreach v in purch_oo_n purch_oo_v purch_nonoo_n purch_nonoo_v ///
>              refi_n refi_v cashout_n cashout_v total_n total_v {
  2.     use "$OUT/_hmda_panel.dta", clear
  3.     di as result _n "===== HMDA outcome `v' ====="
  4.     lpdid ihs_`v', unit(tract_num) time(year) treat(treat) ///
>         pre_window(3) post_window(3) nograph
  5.     matrix E = e(results)
  6.     grabmat E H_`v' event
  7.     capture matrix P = e(pooled_results)
  8.     if !_rc grabmat P H_`v' pooled
  9. }

