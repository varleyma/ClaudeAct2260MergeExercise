. foreach v in purch_hisp_n purch_nonhisp_n {
  2.     di as result _n "===== POISSON event study: `v' ====="
  3.     ppmlhdfe `v' Dm4 Dm3 Dm2 D0 D1 D2 D3, absorb(tract_num year) vce(clust
> er tract_num)
  4.     post `pf' ("`v'") (-4) (_b[Dm4]) (_se[Dm4])
  5.     post `pf' ("`v'") (-3) (_b[Dm3]) (_se[Dm3])
  6.     post `pf' ("`v'") (-2) (_b[Dm2]) (_se[Dm2])
  7.     post `pf' ("`v'") (-1) (0) (.)
  8.     post `pf' ("`v'") (0)  (_b[D0]) (_se[D0])
  9.     post `pf' ("`v'") (1)  (_b[D1]) (_se[D1])
 10.     post `pf' ("`v'") (2)  (_b[D2]) (_se[D2])
 11.     post `pf' ("`v'") (3)  (_b[D3]) (_se[D3])
 12. 
.     di as result _n "===== POISSON pooled post: `v' ====="
 13.     ppmlhdfe `v' treat, absorb(tract_num year) vce(cluster tract_num)
 14.     post `pf' ("`v'") (99) (_b[treat]) (_se[treat])
 15. }

