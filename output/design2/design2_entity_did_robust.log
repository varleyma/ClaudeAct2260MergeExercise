. capture program drop runes

. program define runes
  1.     args yvar spec cond pf
  2.     preserve
  3.     if "`cond'" != "" keep if `cond'
  4.     di as result _n "===== `spec' ====="
  5.     reghdfe `yvar' Dm4 Dm3 Dm2 D0 D1 D2 D3, absorb(tract_num year) vce(clu
> ster tract_num)
  6.     foreach h in -4 -3 -2 0 1 2 3 {
  7.         local d = cond(`h' < 0, "Dm" + string(-`h'), "D" + string(`h'))
  8.         post `pf' ("`spec'") (`h') (_b[`d']) (_se[`d'])
  9.     }
 10.     post `pf' ("`spec'") (-1) (0) (.)
 11.     restore
 12. end

