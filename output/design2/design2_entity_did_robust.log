. /*===========================================================================
> =
>   POOLED DiD, post capped at t=2: PMD LP-DiD with H=2, k=4 (the paper's
>   estimator; avoids the staggered pooled-TWFE artifact). One Treated
>   coefficient per robustness spec.
> ============================================================================*
> /
. tempname pp

. postfile `pp' str16 spec double b se r2 nobs using "$OUT/_erp.dta", replace
(file
    C:/Users/mva284/Documents/GitHub/ClaudeAct2260MergeExercise/output/design
    > 2/_erp.dta not found)

. 
. capture program drop pmdrun

. program define pmdrun
  1.     * pmdrun <yvar> <spec> <cond> <pp>
.     args yvar spec cond pp
  2.     preserve
  3.     if "`cond'" != "" keep if `cond'
  4.     xtset tract_num year
  5.     gen y0  = `yvar'
  6.     gen yf1 = F1.`yvar'
  7.     gen yf2 = F2.`yvar'
  8.     gen yl1 = L1.`yvar'
  9.     gen yl2 = L2.`yvar'
 10.     gen yl3 = L3.`yvar'
 11.     gen yl4 = L4.`yvar'
 12.     egen postm = rowmean(y0 yf1 yf2)
 13.     egen prem  = rowmean(yl1 yl2 yl3 yl4)
 14.     gen pmd = postm - prem
 15.     gen dD = treat == 1 & L1.treat == 0
 16.     egen evertr = max(treat), by(tract_num)
 17.     keep if dD == 1 | evertr == 0
 18.     di as result _n "===== PMD H=2 [`spec'] ====="
 19.     reghdfe pmd dD, absorb(year) vce(cluster tract_num)
 20.     post `pp' ("`spec'") (_b[dD]) (_se[dD]) (e(r2)) (e(N))
 21.     restore
 22. end

