. foreach b in 0_250 250_500 500_1000 1000_1750 1750_2500 2500_3500 3500_4000 {
  2.     use "$OUT/_decay5k_sales.dta", clear
  3.     keep if inlist(bin, "`b'", "control")
  4.     gen near = bin == "`b'"
  5.     egen cellid = group(event_id near)
  6.     collapse (mean) y = lnp (first) near ett (count) nsales = salesamt, //
> /
>         by(cellid tt)
  7.     drop if missing(y)
  8.     gen treat = near & tt >= ett
  9.     xtset cellid tt
 10.     di as result _n "===== decay bin `b' vs control `CTRL_MIN'-`CTRL_MAX' 
> ====="
 11.     lpdid y, unit(cellid) time(tt) treat(treat) ///
>         pre_window(4) post_window(3) nevertreated
 12.     capture graph rename Graph d5k_`b', replace
 13.     local tag "D_`b'"
 14.     matrix E = e(results)
 15.     grabmat E `tag' event
 16.     capture matrix P = e(pooled_results)
 17.     if !_rc grabmat P `tag' pooled
 18. }
