. foreach r in 250 500 1000 {
  2.     foreach k in 1 2 3 {
  3.         qui summ any_`r'_y`k' if pioneer == 1 & obs_y`k' == 1
  4.         local mp = r(mean)
  5.         local np = r(N)
  6.         qui summ any_`r'_y`k' if pioneer == 0 & obs_y`k' == 1
  7.         local mc = r(mean)
  8.         local nc = r(N)
  9. 
.         di as result _n "===== radius `r'm, horizon `k'y: raw P(follow) " ///
>             %5.3f `mp' " (pioneer) vs " %5.3f `mc' " (virgin luxury) ====="
 10. 
.         * LPM with year + municipio FE
.         capture noisily reghdfe any_`r'_y`k' pioneer if obs_y`k' == 1, ///
>             absorb(year muni) vce(cluster muni)
 11.         if !_rc {
 12.             local b = _b[pioneer]
 13.             local s = _se[pioneer]
 14.             local pv = 2 * ttail(e(df_r), abs(`b'/`s'))
 15.             post PF ("lpm") (`r') (`k') (`b') (`s') (`pv') (`mp') (`mc') (
> `np') (`nc')
 16.         }
 17. 
.         * PPML on counts
.         capture noisily ppmlhdfe n_`r'_y`k' pioneer if obs_y`k' == 1, ///
>             absorb(year muni) vce(cluster muni)
 18.         if !_rc {
 19.             local b = _b[pioneer]
 20.             local s = _se[pioneer]
 21.             local pv = 2 * normal(-abs(`b'/`s'))
 22.             post PF ("ppml") (`r') (`k') (`b') (`s') (`pv') (`mp') (`mc') 
> (`np') (`nc')
 23.         }
 24.     }
 25. }

