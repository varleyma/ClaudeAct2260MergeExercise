. local bands "400_1000 1000_1500 1500_2000 2000_2500 2500_3500"

. foreach bnd of local bands {
  2.     local cmin = real(substr("`bnd'", 1, strpos("`bnd'", "_") - 1))
  3.     local cmax = real(substr("`bnd'", strpos("`bnd'", "_") + 1, .))
  4.     use "$OUT/_ladder_sales.dta", clear
  5.     keep if dist_m <= 250 | (dist_m > `cmin' & dist_m <= `cmax')
  6.     gen near = dist_m <= 250
  7.     egen cellid = group(event_id near)
  8.     collapse (mean) y = lnp (first) near ett (count) nsales = salesamt, //
> /
>         by(cellid tt)
  9.     drop if missing(y)
 10.     gen treat = near & tt >= ett
 11.     xtset cellid tt
 12.     di as result _n "===== near 0-250m vs control `cmin'-`cmax' ====="
 13.     lpdid y, unit(cellid) time(tt) treat(treat) ///
>         pre_window(4) post_window(3) nevertreated
 14.     capture graph rename Graph lad_`bnd', replace
 15.     local tag "C_`bnd'"
 16.     matrix E = e(results)
 17.     grabmat E `tag' event
 18.     capture matrix P = e(pooled_results)
 19.     if !_rc grabmat P `tag' pooled
 20. }
