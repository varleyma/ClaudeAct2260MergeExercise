\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces \textbf  {Tract-level event study: log house price.} Annual LP-DiD on the Red Atlas panel, 235 treated tracts vs never-treated controls; base and county-FE series are indistinguishable and pre-trends are flat.}}{11}{figure.caption.11}\protected@file@percent }
\newlabel{fig:tract_es}{{11}{11}{\textbf {Tract-level event study: log house price.} Annual LP-DiD on the Red Atlas panel, 235 treated tracts vs never-treated controls; base and county-FE series are indistinguishable and pre-trends are flat}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces \textbf  {Tract-level event study by investor concentration.} Tracts with 5+ identified purchases versus tracts with 1--4, each against never-treated controls: the concentration result at tract scale.}}{12}{figure.caption.12}\protected@file@percent }
\newlabel{fig:tract_dose}{{12}{12}{\textbf {Tract-level event study by investor concentration.} Tracts with 5+ identified purchases versus tracts with 1--4, each against never-treated controls: the concentration result at tract scale}{figure.caption.12}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Reconciliation: the whole vs the sum of the parts}{12}{subsection.5.3}\protected@file@percent }
