\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces \textbf  {Purchase originations by borrower ethnicity.} Poisson event studies for Hispanic and non-Hispanic borrower purchase counts in treated tracts. Non-Hispanic counts are thin island-wide (a few hundred per year), hence the wide intervals.}}{15}{figure.caption.14}\protected@file@percent }
\newlabel{fig:hmdaeth}{{14}{15}{\textbf {Purchase originations by borrower ethnicity.} Poisson event studies for Hispanic and non-Hispanic borrower purchase counts in treated tracts. Non-Hispanic counts are thin island-wide (a few hundred per year), hence the wide intervals}{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces \textbf  {Income of purchase borrowers.} Effect on $100\times \ln $(mean borrower income) among purchase originations in treated tracts, all classified borrowers and Hispanic borrowers only. Note the monotone pre-period climb ($\approx \!+2.2$ log points/yr): much of the post-period rise extrapolates that drift, so the acceleration attributable to treatment is modest (see text).}}{15}{figure.caption.15}\protected@file@percent }
\newlabel{fig:hmdainc}{{15}{15}{\textbf {Income of purchase borrowers.} Effect on $100\times \ln $(mean borrower income) among purchase originations in treated tracts, all classified borrowers and Hispanic borrowers only. Note the monotone pre-period climb ($\approx \!+2.2$ log points/yr): much of the post-period rise extrapolates that drift, so the acceleration attributable to treatment is modest (see text)}{figure.caption.15}{}}
