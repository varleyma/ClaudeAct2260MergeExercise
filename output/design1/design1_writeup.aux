\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces \textbf  {Observed tract effects vs ring-implied predictions.} Observed: LP-DiD pooled post estimates by dose group. Predictions: stock-value-weighted distance-gradient effects over each treated tract's parcels. The all-treated and 1--4-purchase groups sit on their predictions; the 5+ group's excess ($\approx $11 log points) is the concentration channel.}}{13}{figure.caption.13}\protected@file@percent }
\newlabel{fig:reconciliation}{{13}{13}{\textbf {Observed tract effects vs ring-implied predictions.} Observed: LP-DiD pooled post estimates by dose group. Predictions: stock-value-weighted distance-gradient effects over each treated tract's parcels. The all-treated and 1--4-purchase groups sit on their predictions; the 5+ group's excess ($\approx $11 log points) is the concentration channel}{figure.caption.13}{}}
