\newlabel{fig:nhpurch}{{16}{21}{\textbf {Purchase originations by non-Hispanic borrowers, 2012--2024 panel.} Poisson event study, treated vs.\ never-treated tracts. Pooled $+37$\% (s.e.\ $14$)}{figure.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces \textbf  {Refinancings by non-Hispanic borrowers, 2012--2024 panel.} Same population (first-lien owner-occupied 1--4 family; all refi types --- the cash-out split does not exist before 2018). Pooled $+70$\% (s.e.\ $17$), rising to $+176$\% (s.e.\ $34$) at $h\!\ge \!3$.}}{21}{figure.caption.22}\protected@file@percent }
\newlabel{fig:nhrefi}{{17}{21}{\textbf {Refinancings by non-Hispanic borrowers, 2012--2024 panel.} Same population (first-lien owner-occupied 1--4 family; all refi types --- the cash-out split does not exist before 2018). Pooled $+70$\% (s.e.\ $17$), rising to $+176$\% (s.e.\ $34$) at $h\!\ge \!3$}{figure.caption.22}{}}
