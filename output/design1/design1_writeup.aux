\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces \textbf  {Income of purchase borrowers, 2012--2024 panel.} Effect on $100\times \ln $(mean borrower income) among first-lien owner-occupied purchase originations in treated tracts; all classified borrowers and Hispanic borrowers only. No pre-trend (endpoint binned at $-4$ pools horizons back to $-6$); pooled $+9.6$\% (s.e.\ $1.9$).}}{19}{figure.caption.18}\protected@file@percent }
\newlabel{fig:hmdainc}{{14}{19}{\textbf {Income of purchase borrowers, 2012--2024 panel.} Effect on $100\times \ln $(mean borrower income) among first-lien owner-occupied purchase originations in treated tracts; all classified borrowers and Hispanic borrowers only. No pre-trend (endpoint binned at $-4$ pools horizons back to $-6$); pooled $+9.6$\% (s.e.\ $1.9$)}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces \textbf  {Borrower income by investor concentration, 2012--2024 panel.} Each series: that treated group vs.\ never-treated tracts. The income shift is twice as large in 5+-purchase tracts ($+17.6$\%, s.e.\ $4.9$) as in 1--4-purchase tracts ($+7.9$\%, s.e.\ $2.0$) --- the same concentration gradient as prices.}}{20}{figure.caption.19}\protected@file@percent }
\newlabel{fig:hmdaincdose}{{15}{20}{\textbf {Borrower income by investor concentration, 2012--2024 panel.} Each series: that treated group vs.\ never-treated tracts. The income shift is twice as large in 5+-purchase tracts ($+17.6$\%, s.e.\^^M$4.9$) as in 1--4-purchase tracts ($+7.9$\%, s.e.\ $2.0$) --- the same concentration gradient as prices}{figure.caption.19}{}}
