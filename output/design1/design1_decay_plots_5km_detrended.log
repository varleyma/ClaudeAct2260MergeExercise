(7 missing values generated)

. replace lb = b - 1.96*se if missing(lb) & !missing(se)
(0 real changes made)

. replace ub = b + 1.96*se if missing(ub) & !missing(se)
(0 real changes made)

. drop if missing(b)
(0 observations deleted)

. 
. gen horizon = .
(70 missing values generated)

