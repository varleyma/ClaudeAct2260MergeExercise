. gen slope  = .
(70 missing values generated)

. levelsof test, local(T)
`"D_0_250"' `"D_1000_1750"' `"D_1750_2500"' `"D_2500_3500"' `"D_250_500"' `"D_3
> 500_4000"' `"D_500_1000"'

. foreach t of local T {
  2.     qui reg b c.hp1 if test == "`t'" & matrix_type == "event" & horizon < 
> 0, nocons
  3.     local s = _b[hp1]
  4.     di as result "bin `t': pre-period linear drift = " %6.4f `s' " per yea
> r"
  5.     replace slope = `s' if test == "`t'"
  6.     replace b_adj  = b  - `s'*hp1 if test == "`t'" & matrix_type == "event
> "
  7.     replace lb_adj = lb - `s'*hp1 if test == "`t'" & matrix_type == "event
> "
  8.     replace ub_adj = ub - `s'*hp1 if test == "`t'" & matrix_type == "event
> "
  9.     replace b_adj  = b  - `s'*2.5 if test == "`t'" & matrix_type == "poole
> d" & lower(rowname) == "post"
 10.     replace lb_adj = lb - `s'*2.5 if test == "`t'" & matrix_type == "poole
> d" & lower(rowname) == "post"
 11.     replace ub_adj = ub - `s'*2.5 if test == "`t'" & matrix_type == "poole
> d" & lower(rowname) == "post"
 12.     replace b_adj  = b  + `s'*1.5 if test == "`t'" & matrix_type == "poole
> d" & lower(rowname) == "pre"
 13.     replace lb_adj = lb + `s'*1.5 if test == "`t'" & matrix_type == "poole
> d" & lower(rowname) == "pre"
 14.     replace ub_adj = ub + `s'*1.5 if test == "`t'" & matrix_type == "poole
> d" & lower(rowname) == "pre"
 15. }
