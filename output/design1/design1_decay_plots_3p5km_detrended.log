. use `coefs', clear

. keep if matrix_type == "pooled"
(40 observations deleted)

. gen post = lower(rowname) == "post"

. gen mid = .
(10 missing values generated)

. replace mid = 125  if test == "D_0_250"
(2 real changes made)

. replace mid = 375  if test == "D_250_500"
(2 real changes made)

. replace mid = 750  if test == "D_500_1000"
(2 real changes made)

. replace mid = 1375 if test == "D_1000_1750"
(2 real changes made)

. replace mid = 2125 if test == "D_1750_2500"
(2 real changes made)

. drop if missing(mid)
(0 observations deleted)

. gen x  = mid

. gen xr = mid - 55

. gen xp = mid + 55

. sort post x

. 
. twoway ///
>     (rcap ub lb xr if post, lcolor(gs10) lwidth(thin)) ///
>     (connected b xr if post, color(gs10) msymbol(Th) lpattern(shortdash) lwid
> th(thin) sort(xr)) ///
