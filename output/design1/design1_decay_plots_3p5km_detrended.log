. /*===========================================================================
> =
>   DETRENDED EVENT-STUDY OVERLAYS
> ============================================================================*
> /
. capture program drop drawadj

. program define drawadj
  1.     syntax, out(string)
  2.     local STYLE  graphregion(color(white)) bgcolor(white) ///
>                  ylabel(, angle(horizontal) format(%9.2f)) ///
>                  yline(0, lcolor(gs8) lwidth(thin)) ///
>                  xline(-0.5, lcolor(gs11) lpattern(dash))
  3.     local colors navy cranberry dkorange
  4.     local n : word count $FIG_TESTS
  5.     local plots
  6.     local legorder
  7.     local i = 0
  8.     foreach t of global FIG_TESTS {
  9.         local ++i
 10.         local col : word `i' of `colors'
 11.         local off = cond(`n'==1, 0, (`i' - (`n'+1)/2) * 0.12)
 12.         capture drop x`i'
 13.         gen x`i' = horizon + `off' if test == "`t'"
 14.         local lab : word `i' of $FIG_LABELS
 15.         local plots `plots' ///
>             (rcap ub_adj lb_adj x`i' if test == "`t'", lcolor(`col') lwidth(m
> edthin)) ///
>             (connected b_adj x`i' if test == "`t'", color(`col') msymbol(O) l
> width(medthin))
 16.         local legorder `legorder' `= 2*`i'' "`lab'"
 17.     }
 18.     twoway `plots', `STYLE' ///
>         legend(order(`legorder') rows(1) region(lstyle(none))) ///
>         title("$FIG_TITLE", size(medium)) ///
>         ytitle("$FIG_YT") xtitle("$FIG_XT") ///
>         note("$FIG_NOTE", size(vsmall)) ///
>         xlabel(-4(1)3) name(`out', replace)
 19.     graph export "$OUT/`out'.png", replace width(2000)
 20. end

. 
. local XT "Years since investor purchase (0 = purchase year)"

. local YT "Detrended effect on log sale price"

. local CAVEAT "EXPLORATORY: per-bin linear pre-drift projected out (fit throug
> h base period, extrapolated post); CIs shifted, not widened -- uncertainty un
> derstated. Control band 2,500-3,500m."

. 
