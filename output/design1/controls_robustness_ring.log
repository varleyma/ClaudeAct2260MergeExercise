. foreach y in lnp netin {
  2.     use `panel', clear
  3.     drop if missing(`y')
  4.     xtset cellid tt
  5.     gen y0  = `y'
  6.     gen yf1 = F1.`y'
  7.     gen yf2 = F2.`y'
  8.     gen yf3 = F3.`y'
  9.     gen yl1 = L1.`y'
 10.     gen yl2 = L2.`y'
 11.     gen yl3 = L3.`y'
 12.     gen yl4 = L4.`y'
 13.     egen postm = rowmean(y0 yf1 yf2 yf3)
 14.     egen prem  = rowmean(yl1 yl2 yl3 yl4)
 15.     gen pmd = postm - prem
 16.     gen dD = treat == 1 & L1.treat == 0
 17.     egen evertr = max(treat), by(cellid)
 18.     keep if dD == 1 | evertr == 0
 19.     forvalues s = 1/3 {
 20.         if `s' == 1 local abs absorb(tt)
 21.         else        local abs absorb(cyear)
 22.         local rhs dD
 23.         if `s' == 3 local rhs dD $ZP
 24.         di as result _n "===== ring PMD `y' spec `s' ====="
 25.         reghdfe pmd `rhs', `abs' vce(cluster cellid)
 26.         post `pf' ("ring_`y'") (`s') (_b[dD]) (_se[dD]) (e(r2)) (e(N))
 27.     }
 28. }
