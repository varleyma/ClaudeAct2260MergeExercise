. global HED lnstru lncab subu vac

. 
. foreach y in lnp netin {
  2.     use `panel', clear
  3.     drop if missing(`y')
  4.     xtset cellid tt
  5.     * PMD transform: outcome and each hedonic control identically
.     foreach v in `y' $HED {
  6.         gen h0_`v'  = `v'
  7.         gen hf1_`v' = F1.`v'
  8.         gen hf2_`v' = F2.`v'
  9.         gen hf3_`v' = F3.`v'
 10.         gen hl1_`v' = L1.`v'
 11.         gen hl2_`v' = L2.`v'
 12.         gen hl3_`v' = L3.`v'
 13.         gen hl4_`v' = L4.`v'
 14.         egen postm_`v' = rowmean(h0_`v' hf1_`v' hf2_`v' hf3_`v')
 15.         egen prem_`v'  = rowmean(hl1_`v' hl2_`v' hl3_`v' hl4_`v')
 16.         gen pmd_`v' = postm_`v' - prem_`v'
 17.     }
 18.     gen pmd = pmd_`y'
 19.     gen dD = treat == 1 & L1.treat == 0
 20.     egen evertr = max(treat), by(cellid)
 21.     keep if dD == 1 | evertr == 0
 22.     local HEDP
 23.     foreach c of global HED {
 24.         local HEDP `HEDP' pmd_`c'
 25.     }
 26.     * X x post-treatment (PRCS): kept as unreported spec 4
.     global ZPD
 27.     foreach c of global CTRLS {
 28.         capture drop zpd_`c'
 29.         gen zpd_`c' = z_`c' * dD
 30.         global ZPD $ZPD zpd_`c'
 31.     }
 32.     forvalues s = 1/4 {
 33.         if `s' == 1 local abs absorb(tt)
 34.         else        local abs absorb(cyear)
 35.         local rhs dD
 36.         if `s' == 3 local rhs dD `HEDP'
 37.         if `s' == 4 local rhs dD $ZPD
 38.         di as result _n "===== ring PMD `y' spec `s' ====="
 39.         reghdfe pmd `rhs', `abs' vce(cluster cellid)
 40.         post `pf' ("ring_`y'") (`s') (_b[dD]) (_se[dD]) (e(r2)) (e(N))
 41.     }
 42. }
