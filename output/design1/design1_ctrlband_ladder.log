. gen edate = date(event_date, "YMD")

. gen etm   = (year(sdate)*12 + month(sdate)) - (year(edate)*12 + month(edate))
(142,632 missing values generated)

. gen tt    = yofd(sdate)
(142,632 missing values generated)

. gen ett   = yofd(edate)

