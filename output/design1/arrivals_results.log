. /*===========================================================================
> =
>   LPDID: per treated bin vs control, by sample
> ============================================================================*
> /
. * "first" = naive first-investor sample (no other-buyer event within 1km at
. * the event date, n=237): pre-window arrivals within 1km are mechanically
. * zero -- which IS the state of the world for a first arrival (user call
. * 2026-11-03); the control band may still have prior events beyond 1km.
. foreach samp in all pioneer established first {
  2.     foreach b in 0_250 250_500 500_1000 1000_1500 {
  3.         use "$OUT/_arrivals_panel.dta", clear
  4.         if "`samp'" == "pioneer"     keep if pioneer4 == 1
  5.         if "`samp'" == "established" keep if pioneer4 == 0
  6.         if "`samp'" == "first"       keep if pioneer == 1
  7.         keep if inlist(bin, "`b'", "control")
  8.         gen near = bin == "`b'"
  9.         egen cellid = group(event_id near)
 10.         gen treat = near & year >= event_year
 11.         xtset cellid year
 12.         di as result _n "===== arrivals `samp' | bin `b' vs control 1500-2
> 000 ====="
 13.         capture noisily lpdid y, unit(cellid) time(year) treat(treat) ///
>             pre_window(4) post_window(3) nevertreated
 14.         if _rc continue
 15.         local tag "A_`b'_`samp'"
 16.         matrix E = e(results)
 17.         grabmat E `tag' event
 18.         capture matrix P = e(pooled_results)
 19.         if !_rc grabmat P `tag' pooled
 20.     }
 21. }
