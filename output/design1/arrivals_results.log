. /*===========================================================================
> =
>   PPML robustness: stacked, proportional effects, all bins at once
> ============================================================================*
> /
. capture postclose PH

. postfile PH str12 sample str12 bin double k coef se using "$OUT/_arrivals_ppm
> l.dta", replace
(file
    C:/Users/mva284/Documents/GitHub/ClaudeAct2260MergeExercise/output/design
    > 1/_arrivals_ppml.dta not found)

. 
. foreach samp in all pioneer established first {
  2.     use "$OUT/_arrivals_panel.dta", clear
  3.     if "`samp'" == "pioneer"     keep if pioneer4 == 1
  4.     if "`samp'" == "established" keep if pioneer4 == 0
  5.     if "`samp'" == "first"       keep if pioneer == 1
  6.     gen k = year - event_year
  7.     gen kk = k + 6                      // 0..11, base 5 (k = -1)
  8.     encode bin, gen(binn)               // alphabetical: control is some l
> evel
  9.     qui levelsof binn if bin == "control", local(cb)
 10.     egen ebin  = group(event_id bin)
 11.     egen eyear = group(event_id year)
 12.     egen evid  = group(event_id)
 13.     di as result _n "===== PPML arrivals `samp' (base: control band, k=-1)
>  ====="
 14.     capture noisily ppmlhdfe arrivals ib`cb'.binn#ib5.kk, ///
>         absorb(ebin eyear) vce(cluster evid) d
 15.     if _rc continue
 16.     matrix b = e(b)
 17.     matrix V = e(V)
 18.     local cn : colfullnames b
 19.     local j = 0
 20.     foreach n of local cn {
 21.         local ++j
 22.         if strpos("`n'", "#") == 0 continue
 23.         if strpos("`n'", "b.") | strpos("`n'", "o.") continue
 24.         * name like  3.binn#7.kk
.         local bl = real(substr("`n'", 1, strpos("`n'", ".") - 1))
 25.         local rest = substr("`n'", strpos("`n'", "#") + 1, .)
 26.         local kv = real(substr("`rest'", 1, strpos("`rest'", ".") - 1)) - 
> 6
 27.         local blab : label binn `bl'
 28.         post PH ("`samp'") ("`blab'") (`kv') (b[1, `j']) (sqrt(V[`j', `j']
> ))
 29.     }
 30. }

