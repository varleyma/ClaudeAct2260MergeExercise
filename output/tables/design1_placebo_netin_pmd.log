> ign1_placebo_netin_pmd.do 

. /*===========================================================================
> ===
>  design1_placebo_netin_pmd.do
> 
>  PMD LP-DiD post-pre for NET H->NH ownership conversion under the placebo
>  comparison: real investor events vs 1,500 placebo luxury purchases by
>  individual non-investor buyers, both with far rings matched at 400-750m
>  (the placebo table's convention; same sample rules as design_pmd_stats.do
>  T6_real_far750 / T6_placebo). If conversion is an investor phenomenon and
>  not a generic luxury-transaction effect, the placebo should be null.
> 
>  Output: output/tables/pmd_stats_placebo_netin.csv
>          (keys T6n_real_far750, T6n_placebo)
> =============================================================================
> =*/
. 
. version 17

. clear all

. set more off

. 
. global REPO "C:/Users/mva284/Documents/GitHub/ClaudeAct2260MergeExercise"

. global D1   "$REPO/data/design1"

. global OUT  "$REPO/output/tables"

. 
. capture which reghdfe

. if _rc ssc install reghdfe, replace

. 
. capture program drop pmdcell

. program define pmdcell
  1.     * pmdcell <test> <pf> -- expects sale rows with event_id ring tt ett n
> etin
.     args test pf
  2.     preserve
  3.     egen cellid = group(event_id ring)
  4.     gen near = ring == "near_0_250"
  5.     collapse (mean) y = netin (first) near ett, by(cellid tt)
  6.     drop if missing(y)
  7.     gen treat = near & tt >= ett
  8.     xtset cellid tt
  9.     gen y0  = y
 10.     gen yf1 = F1.y
 11.     gen yf2 = F2.y
 12.     gen yf3 = F3.y
 13.     gen yl1 = L1.y
 14.     gen yl2 = L2.y
 15.     gen yl3 = L3.y
 16.     gen yl4 = L4.y
 17.     egen postm = rowmean(y0 yf1 yf2 yf3)
 18.     egen prem  = rowmean(yl1 yl2 yl3 yl4)
 19.     gen pmd = postm - prem
 20.     gen dD = treat == 1 & L1.treat == 0
 21.     egen evertr = max(treat), by(cellid)
 22.     keep if dD == 1 | evertr == 0
 23.     di as result _n "===== PMD netin [`test'] ====="
 24.     reghdfe pmd dD, absorb(tt) vce(cluster cellid)
 25.     post `pf' ("`test'") (_b[dD]) (_se[dD]) (e(r2)) (e(N))
 26.     restore
 27. end

. 
. tempname pf

. postfile `pf' str24 test double b se r2 nobs using "$OUT/_pmd_pn.dta", replac
> e
