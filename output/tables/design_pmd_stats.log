salesamt: all characters numeric; replaced as double
dist_m: all characters numeric; replaced as double

. gen sdate = date(sale_date, "YMD")
(142,632 missing values generated)

. gen edate = date(event_date, "YMD")

. gen etm   = (year(sdate)*12 + month(sdate)) - (year(edate)*12 + month(edate))
(142,632 missing values generated)

. gen tt    = yofd(sdate)
(142,632 missing values generated)

. gen ett   = yofd(edate)

. drop if flag_junk_date == "True"
(142,888 observations deleted)

. drop if flag_nominal_price == "True"
(7,786,592 observations deleted)

. drop if sale_is_investor_parcel == "True"
(633,345 observations deleted)

. drop if year(edate) < 2012
(694,996 observations deleted)

. keep if salesamt > 0 & !missing(salesamt)
(0 observations deleted)

. keep if inrange(etm, -72, 60)
(13,459,139 observations deleted)

. gen lnp = ln(salesamt)

. save "$OUT/_r2_5km.dta", replace
(file
    C:/Users/mva284/Documents/GitHub/ClaudeAct2260MergeExercise/output/tables
    > /_r2_5km.dta not found)
file
    C:/Users/mva284/Documents/GitHub/ClaudeAct2260MergeExercise/output/tables
    > /_r2_5km.dta saved

. 
. capture program drop r2band

. program define r2band
  1.     * r2band <lo> <hi> <cmin> <cmax> <test>
.     args lo hi cmin cmax test
  2.     use "$OUT/_r2_5km.dta", clear
  3.     keep if (dist_m > `lo' & dist_m <= `hi') | (dist_m > `cmin' & dist_m <
> = `cmax')
  4.     gen near = dist_m > `lo' & dist_m <= `hi'
  5.     egen cellid = group(event_id near)
  6.     collapse (mean) y = lnp (first) near ett (count) n = salesamt, by(cell
> id tt)
  7.     drop if missing(y)
  8.     gen treat = near & tt >= ett
  9.     pmdreg
 10. end

. * note: r2band's lo=0 uses dist_m > 0; the 0-250 ring includes dist 0 -> use 
> -1
. * main decay spec (control 1500-2000)
. foreach s in "-1 250 D_0_250" "250 500 D_250_500" "500 1000 D_500_1000" "1000
>  1500 D_1000_1500" {
  2.     local lo : word 1 of `s'
  3.     local hi : word 2 of `s'
  4.     local t  : word 3 of `s'
  5.     r2band `lo' `hi' 1500 2000 `t'
  6.     post `pf' ("`t'") ($BB) ($SS) ($R2) ($NN)
  7. }
