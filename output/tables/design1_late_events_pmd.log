    > /_late.dta not found)

. 
. foreach cut in 2012 2018 2020 2022 {
  2.     use `panel', clear
  3.     keep if ett >= `cut'
  4.     qui tab event_id
  5.     local ne = r(r)
  6.     xtset cellid tt
  7.     gen y0  = y
  8.     gen yf1 = F1.y
  9.     gen yf2 = F2.y
 10.     gen yf3 = F3.y
 11.     gen yl1 = L1.y
 12.     gen yl2 = L2.y
 13.     gen yl3 = L3.y
 14.     gen yl4 = L4.y
 15.     egen postm = rowmean(y0 yf1 yf2 yf3)
 16.     egen prem  = rowmean(yl1 yl2 yl3 yl4)
 17.     gen pmd = postm - prem
 18.     gen dD = treat == 1 & L1.treat == 0
 19.     egen evertr = max(treat), by(cellid)
 20.     keep if dD == 1 | evertr == 0
 21.     local key = cond(`cut' == 2012, "T5_all", "T5_`cut'")
 22.     di as result _n "===== PMD lnp, events >= `cut' (`ne' events) ====="
 23.     reghdfe pmd dD, absorb(tt) vce(cluster cellid)
 24.     post `pf' ("`key'") (_b[dD]) (_se[dD]) (e(r2)) (e(N)) (`ne')
 25. }
